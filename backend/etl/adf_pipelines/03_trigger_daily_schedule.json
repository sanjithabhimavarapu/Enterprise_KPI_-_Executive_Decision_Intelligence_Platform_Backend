{
  "name": "TR_Master_ETL_Daily_Schedule",
  "properties": {
    "description": "Daily schedule trigger for the master ETL pipeline. Runs at 2:00 AM UTC every day.",
    "type": "ScheduleTrigger",
    "typeProperties": {
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "startTime": "2026-01-01T02:00:00Z",
        "timeZone": "UTC",
        "schedule": {
          "hours": [2],
          "minutes": [0]
        }
      }
    },
    "pipelines": [
      {
        "pipelineReference": {
          "referenceName": "PL_Master_ETL_Pipeline",
          "type": "PipelineReference"
        },
        "parameters": {
          "LoadDate": "@formatDateTime(trigger().scheduledTime, 'yyyy-MM-dd')",
          "LoadType": "incremental"
        }
      }
    ],
    "annotations": [
      "Production",
      "Daily ETL",
      "2AM UTC"
    ]
  },
  "type": "Microsoft.DataFactory/factories/triggers"
}
