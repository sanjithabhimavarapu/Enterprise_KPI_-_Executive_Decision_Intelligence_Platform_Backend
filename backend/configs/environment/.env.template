# Environment Configuration Template
# Enterprise KPI - Executive Decision Intelligence Platform
# Copy this file to .env and fill in your actual values
# NEVER commit .env to source control

# ── Database ────────────────────────────────────────────────────────────────
DB_SERVER=YOUR_SQL_SERVER
DB_NAME=KPI_DataWarehouse
DB_DRIVER=ODBC Driver 17 for SQL Server
# Leave blank for Windows Authentication; fill both for SQL Auth:
DB_USERNAME=
DB_PASSWORD=

# ── API Server ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-to-a-random-secret-key-in-production
API_DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ── ETL Settings ─────────────────────────────────────────────────────────────
ETL_BATCH_SIZE=10000
ETL_LOAD_TYPE=incremental
ETL_LOG_LEVEL=INFO
ETL_RETRY_ATTEMPTS=3
ETL_RETRY_DELAY_SECONDS=60

# ── Email Alerts ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=kpi-alerts@yourcompany.com
SMTP_PASSWORD=
ALERT_RECIPIENTS=analytics-team@yourcompany.com,dba-team@yourcompany.com
ALERT_FROM=kpi-platform@yourcompany.com

# ── Webhook Notifications ─────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
PAGERDUTY_INTEGRATION_KEY=

# ── Azure Data Factory ────────────────────────────────────────────────────────
ADF_SUBSCRIPTION_ID=
ADF_RESOURCE_GROUP=
ADF_FACTORY_NAME=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── Power BI ──────────────────────────────────────────────────────────────────
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_TENANT_ID=
POWERBI_WORKSPACE_ID=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=backend/logs
LOG_RETENTION_DAYS=90
AUDIT_LOG_ENABLED=true
