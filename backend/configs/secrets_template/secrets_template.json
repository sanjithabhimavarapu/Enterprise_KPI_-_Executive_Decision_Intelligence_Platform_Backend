# Secrets Configuration Template
# Enterprise KPI - Executive Decision Intelligence Platform
#
# HOW TO USE:
#   1. Copy this file to secrets.json (never commit secrets.json)
#   2. Fill in all values marked <REPLACE>
#   3. Set file permissions: chmod 600 secrets.json (Linux/Mac)
#
# For production, use Azure Key Vault or SQL Server Credential objects
# instead of storing secrets in flat files.

{
  "database": {
    "sql_server": {
      "server": "<REPLACE: e.g. localhost\\SQLEXPRESS or server.database.windows.net>",
      "database": "KPI_DataWarehouse",
      "username": "<REPLACE: SQL login username, or leave blank for Windows Auth>",
      "password": "<REPLACE: SQL login password>"
    }
  },
  "api": {
    "secret_key": "<REPLACE: generate with: python -c \"import secrets; print(secrets.token_hex(32))\">",
    "jwt_algorithm": "HS256",
    "jwt_expiry_minutes": 60
  },
  "email": {
    "smtp_host": "<REPLACE: e.g. smtp.office365.com>",
    "smtp_port": 587,
    "username": "<REPLACE: email address>",
    "password": "<REPLACE: email password or app password>"
  },
  "webhooks": {
    "slack": "<REPLACE: https://hooks.slack.com/services/...>",
    "teams": "<REPLACE: https://yourorg.webhook.office.com/...>",
    "pagerduty_key": "<REPLACE: PagerDuty integration key>"
  },
  "azure": {
    "tenant_id": "<REPLACE: Azure AD tenant ID>",
    "client_id": "<REPLACE: App registration client ID>",
    "client_secret": "<REPLACE: App registration client secret>",
    "subscription_id": "<REPLACE: Azure subscription ID>",
    "resource_group": "<REPLACE: Resource group name>",
    "adf_factory_name": "<REPLACE: ADF factory name>"
  },
  "power_bi": {
    "client_id": "<REPLACE: Power BI app client ID>",
    "client_secret": "<REPLACE: Power BI app client secret>",
    "tenant_id": "<REPLACE: Azure AD tenant ID>",
    "workspace_id": "<REPLACE: Power BI workspace GUID>"
  }
}
