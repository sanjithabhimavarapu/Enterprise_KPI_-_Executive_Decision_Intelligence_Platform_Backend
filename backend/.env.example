# Enterprise KPI - Executive Decision Intelligence Platform
# Backend Environment Configuration
# Copy this file to .env and update values as needed

# ===== SERVICE CONFIGURATION =====
SERVICE_NAME=Enterprise_KPI_Executive_Decision_Intelligence_Platform_API
SERVICE_VERSION=1.0.0
SERVICE_ENVIRONMENT=development

# ===== DATABASE CONFIGURATION =====
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=KPI_DataWarehouse
DB_USER=sa
DB_PASSWORD=your_password_here
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# ===== FLASK API CONFIGURATION =====
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False
FLASK_ENV=production

# ===== LOGGING CONFIGURATION =====
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===== CORS CONFIGURATION (For Frontend Integration) =====
CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://192.168.0.12:5000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# ===== POWER BI / FRONTEND CONFIGURATION =====
# Frontend expects this exact API name for connection identification
FRONTEND_API_NAME=Enterprise_KPI_Executive_Decision_Intelligence_Platform_API
FRONTEND_API_URL=http://localhost:5000
FRONTEND_DATABASE_NAME=KPI_DataWarehouse

# ===== ETL CONFIGURATION =====
ETL_ENABLED=True
ETL_SCHEDULE_DAILY_TIME=02:00
ETL_CONTINUE_ON_ERROR=False
ETL_MAX_RETRIES=3

# ===== ALERT CONFIGURATION =====
ALERT_EMAIL_ENABLED=False
ALERT_SLACK_ENABLED=False
ALERT_TEAMS_ENABLED=False
